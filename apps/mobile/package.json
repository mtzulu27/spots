{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:catalog": "node scripts/build-static-catalog.mjs",
    "export:web": "expo export --platform web && node scripts/patch-web-output.mjs",
    "deploy:web": "pnpm export:web && node scripts/deploy-hostinger.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/metro-runtime": "~55.0.6",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@supabase/supabase-js": "^2.100.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~55.0.8",
    "expo-constants": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-image-picker": "^55.0.14",
    "expo-linking": "~55.0.8",
    "expo-router": "~55.0.7",
    "expo-status-bar": "~55.0.4",
    "leaflet": "^1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
